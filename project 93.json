      "parameters": {
        "jsCode": "let rows = '';\n\nfor (const item of $input.all()) {\n  const kpiColor = parseFloat(String(item.json['KPI%']).replace('%','')) < 80 ? '#ffcccc' : '#fff3cd';\n  rows += `\n    <tr>\n      <td style=\"border:1px solid #999; padding:6px;\">${item.json.Employee_ID}</td>\n      <td style=\"border:1px solid #999; padding:6px;\">${item.json.Employee_Name}</td>\n      <td style=\"border:1px solid #999; padding:6px;\">${item.json.City}</td>\n      <td style=\"border:1px solid #999; padding:6px;\">${item.json.Branch}</td>\n      <td style=\"border:1px solid #999; padding:6px;\">${item.json.Sales_Target}</td>\n      <td style=\"border:1px solid #999; padding:6px;\">${item.json.Actual_Sales}</td>\n      <td style=\"border:1px solid #999; padding:6px; background-color:${kpiColor}; font-weight:bold;\">${item.json['KPI%']}</td>\n      <td style=\"border:1px solid #999; padding:6px;\">${item.json.Supervisor}</td>\n    </tr>`;\n}\n\nconst html = `\n<table style=\"border-collapse:collapse; font-family:Arial, sans-serif; font-size:13px; width:100%;\">\n  <tr style=\"background-color:#d9d9d9;\">\n    <th style=\"border:1px solid #999; padding:6px;\">Employee_ID</th>\n    <th style=\"border:1px solid #999; padding:6px;\">Employee_Name</th>\n    <th style=\"border:1px solid #999; padding:6px;\">City</th>\n    <th style=\"border:1px solid #999; padding:6px;\">Branch</th>\n    <th style=\"border:1px solid #999; padding:6px;\">Sales_Target</th>\n    <th style=\"border:1px solid #999; padding:6px;\">Actual_Sales</th>\n    <th style=\"border:1px solid #999; padding:6px;\">KPI%</th>\n    <th style=\"border:1px solid #999; padding:6px;\">Supervisor</th>\n  </tr>\n  ${rows}\n</table>`;\n\nreturn [{ json: { html } }];"
      },
